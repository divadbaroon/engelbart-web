+# What the last CLI call cost. Engelbart's addition, and the reason the
+# command above asks for the JSON envelope at all: without it the CLI
+# answers in plain text and a run has no way to know what its own planning
+# spent, so the only model calls anyone could account for were the
+# supervisor's. The newest figure is kept here for project_agent_trace to
+# put on the turn it belongs to; it is never read from more than one
+# thread, because a turn is one subprocess at a time.
+LAST_CALL = {}
+
+
+def _unwrap(stdout):
+    """The model's answer out of the CLI's JSON envelope, with what the
+    call cost kept aside.
+
+    Every caller downstream of this reads the answer with
+    _last_json_object, which picks the JSON object that ends last — and
+    with an envelope around it, that object is the envelope. So asking for
+    the envelope and not unwrapping it would not merely add a field, it
+    would quietly hand the planner its own receipt instead of its plan.
+    Anything that is not an envelope is passed through untouched."""
+    global LAST_CALL
+    LAST_CALL = {}
+    try:
+        envelope = json.loads(stdout)
+    except (ValueError, TypeError):
+        return stdout
+    if not isinstance(envelope, dict) or "result" not in envelope:
+        return stdout
+    LAST_CALL = {"cost": envelope.get("total_cost_usd"), "turns": envelope.get("num_turns"),
+                 "usage": envelope.get("usage") if isinstance(envelope.get("usage"), dict) else None}
+    result = envelope.get("result")
+    return result if isinstance(result, str) else stdout
+
+
