  "keySets": [
    {
      "id": "play",
      "label": "the movement and rotation keys",
      "keys": [
        "ArrowLeft",
        "ArrowRight",
        "ArrowUp",
        "ArrowDown",
        " ",
        "Space",
        "Spacebar"
      ],
      "generation": {
        "confidence": "high",
        "grounding": "abstraction",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "ui.key"
          }
        ],
        "note": "browser key names are a fixed vocabulary; that these ones move and rotate a piece is a reading of the artifact"
      }
    }
  ],
  "rules": [
    {
      "id": "no-recorded-activity",
      "sub": "NO_RECORDED_ACTIVITY",
      "broad": "UNCLEAR",
      "priority": 10,
      "when": {
        "not": {
          "flag": "observed"
        }
      },
      "description": {
        "cond": [
          {
            "when": {
              "acts": {
                "of": [
                  "keys",
                  "clicks",
                  "typing"
                ],
                "op": "gt",
                "value": 0
              }
            },
            "then": {
              "join": [
                {
                  "lit": "Nothing further was recorded for "
                },
                {
                  "duration": true
                },
                {
                  "lit": "."
                }
              ]
            }
          }
        ],
        "else": {
          "join": [
            {
              "lit": "Nothing was recorded for "
            },
            {
              "duration": true
            },
            {
              "lit": "."
            }
          ]
        }
      },
      "because": {
        "join": [
          {
            "field": "surfaceLabel"
          },
          {
            "lit": " was the last thing open; the interface reports nothing that would tell time spent reading from time away"
          }
        ]
      },
      "confidence": "low",
      "note": "First, and unconditional: time in front of an unchanging screen and time away from the desk look exactly alike."
    },
    {
      "id": "resume-session",
      "sub": "RESUME_SESSION",
      "broad": "ORIENTING",
      "priority": 20,
      "when": {
        "all": [
          {
            "flag": "discontinuity"
          },
          {
            "not": {
              "flag": "submitted"
            }
          }
        ]
      },
      "description": {
        "cond": [
          {
            "when": {
              "controlUsed": [
                "login"
              ]
            },
            "then": {
              "lit": "Signed back in after the page was replaced."
            }
          }
        ],
        "else": {
          "lit": "The page was replaced and the session picked up again."
        }
      },
      "because": {
        "cond": [
          {
            "when": {
              "controlUsed": [
                "login"
              ]
            },
            "then": {
              "lit": "the document behind the page was replaced, and the sign-in was used in what followed"
            }
          }
        ],
        "else": {
          "field": "discontinuity"
        }
      },
      "note": "Behind the sending rules on purpose: a page replaced around a submission must not take the submission's row."
    },
    {
      "id": "experiment-with-reference",
      "sub": "EXPERIMENT_WITH_REFERENCE",
      "broad": "EXPLORING",
      "priority": 30,
      "when": {
        "all": [
          {
            "surfaceRole": [
              "reference"
            ]
          },
          {
            "acts": {
              "of": [
                "keys",
                "clicks"
              ],
              "op": "gt",
              "value": 1
            }
          }
        ]
      },
      "description": {
        "cond": [
          {
            "when": {
              "all": [
                {
                  "acts": {
                    "of": [
                      "keys"
                    ],
                    "op": "gt",
                    "value": 0
                  }
                },
                {
                  "keysIn": "play"
                }
              ]
            },
            "then": {
              "join": [
                {
                  "lit": "Played the reference game"
                },
                {
                  "cond": [
                    {
                      "when": {
                        "enteredBy": [
                          "replay-reference"
                        ]
                      },
                      "then": {
                        "lit": ", after restarting it"
                      }
                    }
                  ],
                  "else": {
                    "lit": ""
                  }
                },
                {
                  "lit": "."
                }
              ]
            }
          }
        ],
        "else": {
          "join": [
            {
              "lit": "Experimented with the reference game"
            },
            {
              "cond": [
                {
                  "when": {
                    "enteredBy": [
                      "replay-reference"
                    ]
                  },
                  "then": {
                    "lit": ", after restarting it"
                  }
                }
              ],
              "else": {
                "lit": ""
              }
            },
            {
              "lit": "."
            }
          ]
        }
      },
      "because": {
        "cond": [
          {
            "when": {
              "all": [
                {
                  "acts": {
                    "of": [
                      "keys"
                    ],
                    "op": "gt",
                    "value": 0
                  }
                },
                {
                  "keysIn": "play"
                }
              ]
            },
            "then": {
              "join": [
                {
                  "count": {
                    "of": [
                      "keys"
                    ],
                    "one": "press",
                    "many": "presses"
                  }
                },
                {
                  "lit": " of "
                },
                {
                  "keys": {
                    "in": "play",
                    "join": ", "
                  }
                },
                {
                  "lit": " in the reference game over "
                },
                {
                  "duration": true
                }
              ]
            }
          }
        ],
        "else": {
          "join": [
            {
              "count": {
                "of": [
                  "keys"
                ],
                "one": "key"
              }
            },
            {
              "lit": " and "
            },
            {
              "count": {
                "of": [
                  "clicks"
                ],
                "one": "click"
              }
            },
            {
              "lit": " in the reference game over "
            },
            {
              "duration": true
            }
          ]
        }
      },
      "note": "What somebody did in a stretch outranks the button that got them into it, which is why this sits above the sign-in and the replay."
    },
    {
      "id": "sign-in",
      "sub": "SIGN_IN",
      "broad": "ORIENTING",
      "priority": 40,
      "when": {
        "all": [
          {
            "controlUsed": [
              "login"
            ]
          },
          {
            "not": {
              "flag": "submitted"
            }
          }
        ]
      },
      "description": {
        "lit": "Signed in to start the session."
      },
      "because": {
        "lit": "the sign-in was used and nothing had been replaced"
      }
    },
    {
      "id": "wait-for-tutor",
      "sub": "WAIT_FOR_TUTOR_RESPONSE",
      "broad": "WAITING",
      "priority": 50,
      "when": {
        "all": [
          {
            "flag": "awaiting"
          },
          {
            "flag": "call"
          },
          {
            "not": {
              "flag": "submitted"
            }
          },
          {
            "not": {
              "flag": "composing"
            }
          }
        ]
      },
      "description": {
        "cond": [
          {
            "when": {
              "channelSaid": "tutor"
            },
            "then": {
              "join": [
                {
                  "lit": "Waited for the tutor, which answered: "
                },
                {
                  "quote": {
                    "source": {
                      "channel": "tutor"
                    },
                    "max": 44
                  }
                },
                {
                  "lit": "."
                }
              ]
            }
          }
        ],
        "else": {
          "lit": "Waited for the tutor to answer."
        }
      },
      "because": {
        "cond": [
          {
            "when": {
              "acts": {
                "of": [
                  "clicks",
                  "keys"
                ],
                "op": "gt",
                "value": 0
              }
            },
            "then": {
              "join": [
                {
                  "lit": "a model call was open for "
                },
                {
                  "duration": true
                },
                {
                  "lit": ", with "
                },
                {
                  "count": {
                    "of": [
                      "clicks",
                      "keys"
                    ],
                    "one": "incidental click and key",
                    "many": "incidental clicks and keys"
                  }
                },
                {
                  "lit": " while it ran"
                }
              ]
            }
          }
        ],
        "else": {
          "join": [
            {
              "lit": "a model call was open for "
            },
            {
              "duration": true
            },
            {
              "lit": " and nothing else was done"
            }
          ]
        }
      },
      "note": "A call has to have been open: a submission that opened none still leaves a stretch after it."
    },
    {
      "id": "submit-response",
      "sub": "SUBMIT_RESPONSE",
      "broad": "ACTING",
      "priority": 60,
      "when": {
        "flag": "submitted"
      },
      "description": {
        "cond": [
          {
            "when": {
              "flag": "entered"
            },
            "then": {
              "join": [
                {
                  "lit": "Sent the tutor a message: "
                },
                {
                  "quote": {
                    "source": {
                      "entered": true
                    },
                    "max": 44
                  }
                },
                {
                  "lit": "."
                }
              ]
            }
          }
        ],
        "else": {
          "lit": "Submitted the response."
        }
      },
      "because": {
        "lit": "a submit was recorded in the trace"
      }
    },
    {
      "id": "generate-game",
      "sub": "GENERATE_GAME",
      "broad": "ACTING",
      "priority": 70,
      "when": {
        "controlUsed": [
          "generate"
        ]
      },
      "description": {
        "lit": "Generated the game from the requirements so far."
      },
      "because": {
        "lit": "the Generate Game action was clicked"
      }
    },
    {
      "id": "advance-to-next-step",
      "sub": "ADVANCE_TO_NEXT_STEP",
      "broad": "ACTING",
      "priority": 80,
      "when": {
        "controlUsed": [
          "next-step"
        ]
      },
      "description": {
        "lit": "Moved on to the next step."
      },
      "because": {
        "lit": "the Next Step action was clicked"
      }
    },
    {
      "id": "session-control",
      "sub": "SESSION_CONTROL",
      "broad": "ACTING",
      "priority": 90,
      "when": {
        "controlUsed": [
          "reset",
          "end",
          "change-game"
        ]
      },
      "description": {
        "cond": [
          {
            "when": {
              "controlUsed": [
                "reset"
              ]
            },
            "then": {
              "lit": "Reset the session."
            }
          },
          {
            "when": {
              "controlUsed": [
                "end"
              ]
            },
            "then": {
              "lit": "Ended the session."
            }
          }
        ],
        "else": {
          "lit": "Changed the game."
        }
      },
      "because": {
        "cond": [
          {
            "when": {
              "controlUsed": [
                "reset"
              ]
            },
            "then": {
              "lit": "the reset control was used"
            }
          },
          {
            "when": {
              "controlUsed": [
                "end"
              ]
            },
            "then": {
              "lit": "the end control was used"
            }
          }
        ],
        "else": {
          "lit": "the change-game control was used"
        }
      }
    },
    {
      "id": "replay-reference",
      "sub": "REPLAY_REFERENCE",
      "broad": "EXPLORING",
      "priority": 100,
      "when": {
        "controlUsed": [
          "replay-reference"
        ]
      },
      "description": {
        "lit": "Replayed the reference game from the start."
