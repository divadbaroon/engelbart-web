{
  "version": 1,
  "artifact": {
    "name": "ROPE"
  },
  "provenance": {
    "by": "handwritten",
    "note": "The existing ROPE taxonomy, written out as data. It exists to test the profile language, not to replace lib/activity/rope.ts: if something here cannot be said, the language is missing an operator."
  },
  "surfaces": [
    {
      "id": "page",
      "match": {
        "equals": [
          "/",
          "top"
        ]
      },
      "label": "the tutoring page",
      "role": "shell",
      "generation": {
        "confidence": "high",
        "grounding": "source",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "frame.loaded"
          }
        ],
        "note": "a single page with no router, so the document itself is the surface; \"top\" is a stage that happened on no document at all"
      }
    },
    {
      "id": "own",
      "match": {
        "equals": "my-canvas"
      },
      "label": "their canvas",
      "role": "own",
      "generation": {
        "confidence": "high",
        "grounding": "source",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "frame.attached"
          }
        ],
        "note": "the sandbox names itself in its own query string"
      }
    },
    {
      "id": "reference",
      "match": {
        "equals": "solution"
      },
      "label": "the reference game",
      "role": "reference",
      "generation": {
        "confidence": "high",
        "grounding": "source",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "frame.attached"
          }
        ]
      }
    },
    {
      "id": "reference-step",
      "match": {
        "glob": "solution-step-*"
      },
      "label": "the reference for step {1}",
      "role": "reference",
      "generation": {
        "confidence": "high",
        "grounding": "abstraction",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "frame.attached"
          }
        ],
        "note": "step frames are minted one per step, so they are matched by shape rather than listed"
      }
    }
  ],
  "channels": [
    {
      "id": "tutor",
      "label": "the tutor",
      "from": "system",
      "container": {
        "selector": {
          "prefix": "main > div:nth-of-type(2) > div:nth-of-type(2) > div > div"
        }
      },
      "generation": {
        "confidence": "medium",
        "grounding": "inference",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "ui.change"
          }
        ],
        "note": "the answer streams into a message of its own inside the conversation, one level below the list that holds them; fitted from one recording, and nothing at that container carries an id, a test id or a role"
      }
    },
    {
      "id": "participant",
      "label": "the person",
      "from": "person",
      "container": {
        "selector": {
          "equals": "main > div:nth-of-type(2) > div:nth-of-type(2) > div"
        }
      },
      "generation": {
        "confidence": "medium",
        "grounding": "inference",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "ui.change"
          }
        ],
        "note": "what a person sent is written straight into the list that holds the messages; that one level is the whole of the difference from the tutor's own words"
      }
    },
    {
      "id": "requirements",
      "label": "the requirements document",
      "from": "system",
      "container": {
        "any": [
          {
            "tag": {
              "equals": "main"
            }
          },
          {
            "selector": {
              "prefix": "main > div:nth-of-type(3)"
            }
          }
        ]
      },
      "generation": {
        "confidence": "medium",
        "grounding": "inference",
        "ev": [
          {
            "kind": "trace",
            "eventKind": "ui.change"
          }
        ],
        "note": "the document fills in a word at a time, and those mutations land on the page container itself"
      }
    }
  ],
  "controls": [
